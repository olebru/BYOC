  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exuarch.Core\Exuarch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>


</Project>
