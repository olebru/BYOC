@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <header class="topbar">
        <a class="brand" href="">
            <svg class="chip" viewBox="0 0 20 20" aria-hidden="true">
                <rect x="4" y="4" width="12" height="12" rx="1.5" />
                <circle cx="7" cy="7" r="1" />
                <path d="M7 1v3M10 1v3M13 1v3M7 16v3M10 16v3M13 16v3M1 7h3M1 10h3M1 13h3M16 7h3M16 10h3M16 13h3" />
            </svg>
            <span class="name">ExµArch</span>
        </a>
        <span class="tagline">explore microarchitectures <span class="sep">/</span> a computer architecture playground</span>
        <span class="spacer"></span>
        <span class="spec">16-bit · two phase clock</span>
        <button class="theme" title="@(theme == "dark" ? "Switch to the light theme" : "Switch to the dark theme")" @onclick="ToggleTheme">@(theme == "dark" ? "☀ light" : "☾ dark")</button>
    </header>

    <main class="main">
        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

@code
{
    // What the page shows now; index.html has already applied it before the first render.
    private string theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("exuarchTheme.current");
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        theme = await JS.InvokeAsync<string>("exuarchTheme.toggle");
    }
}
