@page "/"

@if (PackageError != null)
{
    <div class="alert alert-danger alert-dismissible">@PackageError <button type="button" class="close" @onclick="() => PackageError = null">&times;</button></div>
}

<div class="workspace-header">
    <ul class="nav nav-tabs">
        @foreach (var (tab, index) in Tabs.Select((t, i) => (t, i)))
        {
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == tab ? "active" : "")" href="" @onclick="() => ActiveTab = tab" @onclick:preventDefault>
                    <span class="tab-index">@((index + 1).ToString("00"))</span>@tab
                    @if (tab == "Design" && DefinitionErrors.Count > 0) { <span class="badge badge-danger ml-1">@DefinitionErrors.Count</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount > 0) { <span class="badge badge-danger ml-1">@MicrocodeErrorCount</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount == 0 && MicrocodeWarningCount > 0) { <span class="badge badge-warning ml-1">@MicrocodeWarningCount</span> }
                    @if (tab == "Program" && ProgramErrors.Count > 0) { <span class="badge badge-danger ml-1">@ProgramErrors.Count</span> }
                    @if (tab == "JSON" && ParseErrors.Count > 0) { <span class="badge badge-danger ml-1">@ParseErrors.Count</span> }
                </a>
            </li>
        }
    </ul>
    <div class="workspace-actions">
        <label class="package-label silk" for="package-select">Package</label>
        <select id="package-select" class="form-control form-control-sm package-select" value="@PackageName" @onchange="SelectPackage" title="@Package.Description">
            @foreach (var package in BuiltInPackages.All)
            {
                <option value="@package.Name">@package.Name</option>
            }
            @if (!BuiltInPackages.All.Any(p => p.Name == PackageName))
            {
                <option value="@PackageName">@PackageName (custom)</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" @onclick="OpenNewDialog" title="Start a new machine of your own">New…</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetPackage" title="Load the package's machine and first program again">Reset</button>
        <label class="btn btn-sm btn-outline-secondary mb-0" title="Open a package file: a machine with its microcode and programs">
            Open…<InputFile OnChange="OpenPackage" accept=".json" class="d-none" />
        </label>
        <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadPackage" title="Save the machine, its microcode and the programs as one file">Download</button>
    </div>
</div>

@if (newDialog)
{
    <div class="new-backdrop" @onclick="() => newDialog = false">
        <div class="new-dialog" @onclick:stopPropagation @onkeydown="NewDialogKey">
            <div class="new-title">New machine</div>
            <label class="silk" for="new-name">Name</label>
            <input id="new-name" class="form-control form-control-sm" @bind="newName" @bind:event="oninput" @ref="newNameInput" />
            <div class="silk new-start-label">Start from</div>
            @foreach (var (value, title, description) in NewStarts)
            {
                <label class="new-start @(newStart == value ? "chosen" : "")">
                    <input type="radio" name="new-start" checked="@(newStart == value)" @onchange="() => newStart = value" />
                    <span><strong>@title</strong><small>@description</small></span>
                </label>
            }
            <div class="new-note">The new machine lives in this page until you download it; Download saves it as a package file you can open again.</div>
            <div class="new-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => newDialog = false">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="CreateMachine">Create</button>
            </div>
        </div>
    </div>
}

@if (ActiveTab == "Design")
{
    <MachineEditor Definition="Definition" DefinitionChanged="OnDesignChanged" Errors="DefinitionErrors" Preview="C" Registry="Registry"
                   History="History" OnOpenMicrocode="OpenMicrocode" FocusDevice="@focusDevice" FocusVersion="focusVersion" />
}
else if (ActiveTab == "Microcode")
{
    @if (Definition.Decoder?.Microcode == null)
    {
        <div class="alert alert-warning">
            This machine has no microcode yet.
            <button class="btn btn-sm btn-primary ml-2" @onclick="StartMicrocode">Start with an empty fetch routine</button>
        </div>
    }
    else
    {
        <MicrocodeEditor Microcode="Definition.Decoder.Microcode" MicrocodeChanged="OnMicrocodeChanged" Machine="Definition" Diagnostics="MicrocodeDiagnostics" Registry="Registry"
                         History="History" OnOpenDevice="OpenDevice" FocusMnemonic="@focusMnemonic" FocusStep="focusStep" FocusVersion="focusVersion" />
    }
}
else if (ActiveTab == "Program")
{
    @if (Package.Programs.Count > 0)
    {
    <div class="examples">
        <span class="examples-label silk">Examples · @PackageName</span>
        @foreach (var example in Package.Programs)
        {
            <button class="btn btn-sm @(Program == example.Source ? "btn-primary" : "btn-outline-primary")" title="@example.Description" @onclick="() => LoadExample(example.Source)">@example.Name</button>
        }
    </div>
    }
    <AssemblyEditor Value="@Program" ValueChanged="OnProgramChanged" Microcode="Definition.Decoder?.Microcode" MemorySize="ProgramMemorySize" />
    <ErrorList Errors="@ProgramErrors.Where(e => !e.StartsWith("Line ")).ToList()" />
}
else if (ActiveTab == "JSON")
{
    <ErrorList Errors="ParseErrors" />
    <SourceEditorComponent Label="machine.json · microcode inline · synced with the editors" Value="@DefinitionJson" ValueChanged="OnJsonChanged" Rows="34" />
}
else if (ActiveTab == "Run")
{
    @if (C == null)
    {
        <div class="alert alert-warning">The machine can not run until these problems are fixed:</div>
        <ErrorList Errors="AllErrors.ToList()" />
    }
    else
    {
        <RunView Machine="C" Registry="Registry" OnRestart="Rebuild" />
    }
}
