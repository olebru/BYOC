@if (Microcode != null)
{
<div class="mc-editor">
    <div class="toolbar">
        <button class="tool" title="Undo, shared with the machine editor" disabled="@(History?.CanUndo != true)" @onclick="Undo">Undo</button>
        <button class="tool" title="Redo" disabled="@(History?.CanRedo != true)" @onclick="Redo">Redo</button>
        <span class="sep"></span>
        <button class="tool" @onclick="AddInstruction">＋ Instruction</button>
        <label class="tool import" title="Import microcode JSON or a legacy tab separated ROM">
            Import
            <InputFile OnChange="Import" accept=".json,.tsv,.csv,.txt" />
        </label>
        <button class="tool" title="Save the microcode on its own as a .microcode.json file, which Import here reads back" @onclick="Download">Microcode JSON</button>
        <span class="sep"></span>
        <span class="meter" title="Micro step addresses used, out of the 65536 a 16 bit micro step register can select">
            <span class="meter-bar"><span class="meter-fill @(OpCodesUsed > AddressSpace ? "over" : "")" style="width:@(Math.Max(OpCodesUsed > 0 ? 1 : 0, Math.Min(100, OpCodesUsed * 100 / AddressSpace)))%"></span></span>
            <span class="meter-count"><strong>@OpCodesUsed</strong> / @AddressSpace</span> <span class="silk">opcodes</span>
        </span>
        <HelpLink Target="microcode" Title="Microcode: instructions, steps and signals" />
        <span class="grow"></span>
        @if (Diagnostics.Count == 0)
        {
            <span class="status ok">✓ Microcode is valid for @(Machine?.Name ?? "this machine")</span>
        }
        else
        {
            <button class="status @(ErrorCount > 0 ? "bad" : "warn")" @onclick="() => showProblems = !showProblems">
                @if (ErrorCount > 0) { <span>⚠ @ErrorCount error@(ErrorCount == 1 ? "" : "s")</span> }
                @if (ErrorCount > 0 && WarningCount > 0) { <span> · </span> }
                @if (WarningCount > 0) { <span>@WarningCount warning@(WarningCount == 1 ? "" : "s")</span> }
            </button>
        }
    </div>

    @if (importError != null)
    {
        <div class="problems"><div class="problem">Import failed: @importError <button type="button" class="close" title="Dismiss" @onclick="() => importError = null">&times;</button></div></div>
    }
    @if (showProblems && Diagnostics.Count > 0)
    {
        <div class="problems">
            @foreach (var diagnostic in Diagnostics)
            {
                var instruction = diagnostic.Instruction == null ? null : Microcode.FindInstruction(diagnostic.Instruction);
                <div class="problem @(diagnostic.Severity == DiagnosticSeverity.Warning ? "warning" : "") @(instruction != null ? "linked" : "")"
                     @onclick="() => { if (instruction != null) { Select(instruction); if (diagnostic.Step != null) activeStep = diagnostic.Step.Value; } }">@diagnostic</div>
            }
        </div>
    }

    <div class="body">
        <!-- Instruction list -->
        <div class="list">
            <input class="form-control form-control-sm mb-2" placeholder="Filter instructions" @bind="filter" @bind:event="oninput" />
            @{ var opcodes = OpcodeMap(); }
            @if (Microcode.Fetch != null)
            {
                <div class="list-item fetch @(Selected == Microcode.Fetch ? "selected" : "")" @onclick="() => Select(Microcode.Fetch)">
                    <span class="opcode">@opcodes.GetValueOrDefault(Microcode.Fetch)</span>
                    <span class="mnemonic">@Microcode.Fetch.Mnemonic</span>
                    <span class="badge-fetch">Fetch</span>
                    <span class="desc"></span>
                    <span class="marker @Marker(Microcode.Fetch)"></span>
                </div>
            }
            @for (int i = 0; i < Microcode.Instructions.Count; i++)
            {
                var index = i;
                var instruction = Microcode.Instructions[i];
                if (filter.Length > 0 && !instruction.Mnemonic.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    && !(instruction.Description ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase)) continue;
                <div class="list-item @(Selected == instruction ? "selected" : "")" draggable="true"
                     @ondragstart="() => DragInstruction(index)" @ondragover:preventDefault @ondrop="() => DropOnInstruction(index)"
                     @onclick="() => Select(instruction)" title="@instruction.Description">
                    <span class="opcode">@opcodes.GetValueOrDefault(instruction)</span>
                    <span class="mnemonic">@instruction.Mnemonic</span>
                    @if (instruction.Operands > 0) { <span class="ops">@instruction.Operands op</span> }
                    <span class="desc">@instruction.Description</span>
                    <span class="marker @Marker(instruction)"></span>
                </div>
            }
            <button class="add-instruction" @onclick="AddInstruction">＋ Add instruction</button>
        </div>

        <!-- Instruction editor -->
        <div class="detail">
            @if (Selected != null)
            {
                var instruction = Selected;
                <div class="detail-header">
                    <div class="field mnemonic-field">
                        <label>Mnemonic</label>
                        <input class="form-control form-control-sm @(renameError != null ? "is-invalid" : "")" value="@instruction.Mnemonic" @onchange="e => Rename((string)e.Value)" />
                        @if (renameError != null) { <div class="invalid-feedback d-block">@renameError</div> }
                    </div>
                    @if (!SelectedIsFetch)
                    {
                        <div class="field operands-field">
                            <label>Operands<HelpLink Target="operands" Title="Operands: how many, and value or address" /></label>
                            <input type="number" min="0" max="8" class="form-control form-control-sm" placeholder="?" value="@instruction.Operands" @onchange="e => SetOperands((string)e.Value)" />
                        </div>
                    }
                    @if (!SelectedIsFetch && (instruction.OperandCount ?? 0) > 0)
                    {
                        <div class="field types-field">
                            <label>Operand types</label>
                            <div class="types">
                                @for (int t = 0; t < instruction.OperandCount; t++)
                                {
                                    var index = t;
                                    var type = instruction.OperandTypeAt(index);
                                    <select class="form-control form-control-sm" title="Operand @(index + 1): a value used as it is, an address to read, write or jump to, or a register of the register file"
                                            value="@(type?.ToString() ?? "")" @onchange="e => SetOperandType(index, (string)e.Value)">
                                        <option value="">?</option>
                                        <option value="Value">value</option>
                                        <option value="Address">address</option>
                                        <option value="Register">register</option>
                                    </select>
                                }
                            </div>
                        </div>
                    }
                    <div class="field grow">
                        <label>Description</label>
                        <input class="form-control form-control-sm" value="@instruction.Description" @onchange="e => SetDescription((string)e.Value)" />
                    </div>
                    @if (!SelectedIsFetch)
                    {
                        <div class="field actions">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateInstruction">Duplicate</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteInstruction">Delete</button>
                        </div>
                    }
                </div>
                @if (SelectedIsFetch)
                {
                    <div class="hint">The fetch routine runs at opcode 0 after every instruction resets the micro step register. It should load the next opcode into it.<HelpLink Target="fetch-and-the-instruction-register" Title="Fetch and the instruction register" /></div>
                }

                <div class="preview">
                    <span class="preview-label silk">Preview flags<HelpLink Target="flags-and-conditions" Title="Flags and conditions: which steps run" /></span>
                    <button class="flag @(previewStatus == null ? "on" : "")" @onclick="() => previewStatus = null">all steps</button>
                    @foreach (var flag in Flags)
                    {
                        var on = previewStatus.HasValue && (previewStatus.Value & flag.Flag) != 0;
                        <button class="flag @(on ? "on" : "") @(previewStatus.HasValue ? "" : "idle")" @onclick="() => TogglePreview(flag.Flag)">@flag.Name=@(on ? 1 : 0)</button>
                    }
                    @if (previewStatus.HasValue)
                    {
                        var ticks = instruction.StepsFor(previewStatus.Value).Count;
                        <span class="muted">runs @ticks step@(ticks == 1 ? "" : "s")</span>
                    }
                </div>

                <div class="steps">
                    @for (int s = 0; s < instruction.Steps.Count; s++)
                    {
                        var stepIndex = s;
                        var step = instruction.Steps[s];
                        var stepDiagnostics = DiagnosticsFor(instruction, stepIndex).ToList();
                        var tick = TickOf(instruction, step);
                        <div class="step @(activeStep == stepIndex ? "active" : "") @(Runs(step) ? "" : "dimmed") @(stepDiagnostics.Any(d => d.Severity == DiagnosticSeverity.Error) ? "has-error" : stepDiagnostics.Any() ? "has-warning" : "")"
                             @onclick="() => activeStep = stepIndex" @ondragover:preventDefault @ondrop="() => DropOnStep(stepIndex)">
                            <div class="step-header">
                                <span class="handle" draggable="true" title="Drag to reorder" @ondragstart="() => DragStep(stepIndex)">⋮⋮</span>
                                <span class="step-title">Step @(stepIndex + 1)</span>
                                @if (tick != null) { <span class="tick">tick @(tick + 1)</span> }
                                <span class="conditions" title="Run this step only when the flags match. Click to cycle: any, 1, 0.">
                                    @foreach (var flag in Flags)
                                    {
                                        var state = FlagState(step, flag.Name);
                                        <button class="cond cond-@state" @onclick="() => CycleFlag(step, flag.Name)" @onclick:stopPropagation>@flag.Name@(state == "x" ? "" : "=" + state)</button>
                                    }
                                </span>
                                <span class="grow"></span>
                                <button class="icon" title="Move up" disabled="@(stepIndex == 0)" @onclick="() => MoveStep(stepIndex, stepIndex - 1)" @onclick:stopPropagation>↑</button>
                                <button class="icon" title="Move down" disabled="@(stepIndex == instruction.Steps.Count - 1)" @onclick="() => MoveStep(stepIndex, stepIndex + 1)" @onclick:stopPropagation>↓</button>
                                <button class="icon" title="Duplicate step" @onclick="() => DuplicateStep(stepIndex)" @onclick:stopPropagation>⧉</button>
                                <button class="icon danger" title="Delete step" @onclick="() => DeleteStep(stepIndex)" @onclick:stopPropagation>✕</button>
                            </div>
                            <div class="signals">
                                @foreach (var signal in step.Signals)
                                {
                                    var line = LineFor(signal);
                                    <span class="signal @(SignalHasProblem(instruction, stepIndex, signal) ? "bad" : "")" draggable="true" title="@SignalTitle(signal)"
                                          style="border-left-color:@SignalColor(signal)" @ondragstart="() => DragSignal(stepIndex, signal)" @ondragstart:stopPropagation
                                          @ondblclick="() => OpenDevice(signal)" @ondblclick:stopPropagation>
                                        <span class="dir">@DirectionMark(line)</span>@signal
                                        <button class="remove" title="Remove" @onclick="() => RemoveSignal(stepIndex, signal)" @onclick:stopPropagation>×</button>
                                    </span>
                                }
                                @if (activeStep == stepIndex)
                                {
                                    <input class="add-signal" list="signal-options" placeholder="add device.line" @bind="newSignal" @bind:event="oninput"
                                           @onkeydown="e => OnSignalInputKey(e, stepIndex)" @onchange="() => AddSignalFromInput(stepIndex)" @onclick:stopPropagation />
                                }
                                else if (step.Signals.Count == 0)
                                {
                                    <span class="muted">empty step, drop signals here</span>
                                }
                            </div>
                            @{ var activity = BusActivity(step); }
                            @if (activity.Count > 0)
                            {
                                <div class="bus-activity">
                                    @foreach (var bus in activity)
                                    {
                                        <span class="bus-flow @(bus.Drivers.Count > 1 ? "conflict" : bus.Drivers.Count == 0 ? "floating" : "")">
                                            <span class="bus-name">@bus.Bus</span>
                                            <span class="bus-from">@(bus.Drivers.Count == 0 ? "nothing" : string.Join(" + ", bus.Drivers))</span>
                                            <span class="bus-arrow">→</span>
                                            <span class="bus-to">@(bus.Readers.Count == 0 ? "—" : string.Join(", ", bus.Readers))</span>
                                        </span>
                                    }
                                </div>
                            }
                            @if (activeStep == stepIndex || step.Comment != null)
                            {
                                <input class="comment" placeholder="comment" value="@step.Comment" @onchange="e => SetComment(step, (string)e.Value)" @onclick:stopPropagation />
                            }
                            @foreach (var diagnostic in stepDiagnostics)
                            {
                                <div class="step-problem @(diagnostic.Severity == DiagnosticSeverity.Warning ? "warning" : "")">@diagnostic.Message</div>
                            }
                        </div>
                    }
                    <div class="add-step" @ondragover:preventDefault @ondrop="DropOnNewStep" @onclick="AddStep">＋ Add step <span class="muted">(or drop a signal here)</span></div>
                    @foreach (var diagnostic in DiagnosticsFor(instruction).Where(d => d.Step == null))
                    {
                        <div class="step-problem @(diagnostic.Severity == DiagnosticSeverity.Warning ? "warning" : "")">@diagnostic.Message</div>
                    }
                </div>
                <datalist id="signal-options">
                    @foreach (var option in AllSignals()) { <option value="@option"></option> }
                </datalist>
            }
        </div>

        <!-- Signal palette -->
        <div class="palette">
            <div class="palette-title silk">Control lines</div>
            <div class="palette-hint">Drag onto a step, or click to add to step @(activeStep + 1). ▲ drives a bus, ▼ reads a bus. Double-click a signal in a step to show its device.</div>
            <input class="form-control form-control-sm mb-2" placeholder="Filter" @bind="paletteFilter" @bind:event="oninput" />
            @if (Machine != null)
            {
                @foreach (var device in Machine.Devices)
                {
                    var info = Registry.Info(device.Type);
                    if (info == null) continue;
                    var lines = info.ControlLines.Where(l => paletteFilter.Length == 0 || $"{device.Id}.{l.Name}".Contains(paletteFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                    if (lines.Count == 0) continue;
                    <div class="palette-device" title="@($"{device.Type}: {info.Description}")">
                        <span class="dot" style="background:@Palette.Category(info)"></span>
                        <span class="palette-id">@device.Id</span> <span class="palette-type">@device.Type</span>
                    </div>
                    <div class="palette-lines">
                        @foreach (var line in lines)
                        {
                            var signal = $"{device.Id}.{line.Name}";
                            <span class="palette-line" draggable="true" title="@(LineFor(signal) is ControlLineInfo paletteLine ? SignalDescription(signal, paletteLine) : signal)" @ondragstart="() => DragPaletteSignal(signal)" @onclick="() => PaletteClick(signal)">
                                <span class="dir">@DirectionMark(line)</span>@line.Name
                            </span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
}
