@using Exuarch.Core
@using Microsoft.AspNetCore.Components.Web

@* One card of the machine drawing, the same in the hardware design and the run view: a head with the id and name,
   the device's live state, its connection sockets and its ports. The design canvas makes the parts draggable. *@
<div class="dev @(Interactive ? "interactive" : "") @CssClass"
     style="left:@Px(Left); top:@Px(Top); width:@Px(SchematicLayout.CardWidth); height:@Px(Height); border-top-color:@Color;"
     title="@CardTitle"
     @onpointerdown="OnCardPointerDown" @onpointerdown:stopPropagation="Interactive">
    <div class="dev-head" title="@HeadTitle">
        <span class="dev-id">@Id</span>
        <span class="dev-type">@Kind</span>
    </div>
    @if (Line != null)
    {
        <div class="dev-body stacked">
            <span class="mem">@Line <strong>@LineValue</strong></span>
            <span class="sub">@SubLine</span>
        </div>
    }
    else if (Built != null)
    {
        <div class="dev-body @(Built is MemoryModule || Built is MMU || Built is Clock || Built is ALU || Built is CharacterDisplay || Built is Framebuffer || Built is Blitter || Built is InterruptController || Built is TickTimer || Built is Rasterizer || Built is DepthBuffer || Built is MultiplyAccumulate || Built is RegisterFile ? "stacked" : "") @(Changed ? "changed" : "")" @key="(Changed ? ChangeKey : 0)">
            @switch (Built)
            {
                case StatusRegister status:
                    <span class="flags">
                        <span class="lamp @(status.Negative8 ? "on" : "")">N</span>
                        <span class="lamp @(status.Overflow4 ? "on" : "")">V</span>
                        <span class="lamp @(status.Carry2 ? "on" : "")">C</span>
                        <span class="lamp @(status.Zero1 ? "on" : "")">Z</span>
                    </span>
                    break;
                case InstructionRegister counter:
                    var located = Machine?.NextStep;
                    <span class="value">@Hex(counter.Data)</span>
                    <span class="sub">@(located == null ? "no microcode" : $"{located.Value.Instruction.Mnemonic}.{located.Value.Offset + 1}")</span>
                    break;
                case Register register:
                    <span class="value">@Hex(register.Data)</span>
                    <span class="sub">@register.Data</span>
                    break;
                case DualPortRegister dual:
                    <span class="value">@Hex(dual.Data)</span>
                    <span class="sub">@dual.Data</span>
                    break;
                case RegisterFile file:
                    <span class="dev-regs">
                        @for (int number = 0; number < file.Count; number++)
                        {
                            <i class="@(number == file.Selected ? "on" : "")" title="@($"R{number} = {file[number]}")"><b>R@(number)</b> @file[number].ToString("X4")</i>
                        }
                    </span>
                    break;
                case MemoryModule memory:
                    <span class="mem">MAR <strong>@Hex(memory.memoryAddress)</strong></span>
                    <span class="sub">[@Hex(memory.memoryAddress)] = @Hex(memory.ValueAt(memory.memoryAddress))</span>
                    break;
                case MMU mmu:
                    var bank = mmu.SelectedBank;
                    <span class="mem">bank <strong>@mmu.SelectedBankNumber</strong>  MAR <strong>@Hex(bank.memoryAddress)</strong></span>
                    <span class="sub">[@Hex(bank.memoryAddress)] = @Hex(bank.ValueAt(bank.memoryAddress))</span>
                    break;
                case Clock clock:
                    <span class="mem">@(clock.IsHalted() ? "HALTED" : "running")</span>
                    <span class="sub">@clock.cycle cycles</span>
                    break;
                case CharacterDisplay lcd:
                    var lastChar = lcd.Cursor > 0 ? lcd.Cells[Math.Min(lcd.Cursor, lcd.Cells.Length) - 1] : (byte)0x20;
                    <span class="mem">cursor <strong>@lcd.Cursor</strong></span>
                    <span class="sub">@lcd.Columns×@lcd.Rows · last '@CharacterDisplay.ToChar(lastChar)'</span>
                    break;
                case Framebuffer screenDevice:
                    var lastPixel = screenDevice.LastWriteValue;
                    var (pr, pg, pb) = Framebuffer.ToRgb(lastPixel);
                    <span class="mem">cursor <strong>@screenDevice.X, @screenDevice.Y</strong>@(screenDevice is DoubleFramebuffer pages ? $" · front {pages.FrontBuffer}" : "")</span>
                    <span class="sub"><span class="swatch" style="background:rgb(@pr,@pg,@pb)"></span> last @Hex(lastPixel)</span>
                    break;
                case InterruptController controller:
                    <span class="mem" title="@($"{controller.Requests} requests so far")">@(controller.Enabled ? "on" : "off") · pending @Bits(controller.Pending, 4)</span>
                    <span class="sub">mask @Bits(controller.Mask, 4)</span>
                    break;
                case TickTimer timer:
                    <span class="mem">@(timer.Running ? $"{timer.Count} / {timer.Period}" : "stopped")</span>
                    <span class="sub">@timer.Expired expired</span>
                    break;
                case Blitter blitter:
                    <span class="mem" title="@($"{blitter.JobsDone} jobs done, {blitter.PixelsDrawn} pixels")">@(blitter.Busy ? $"busy {blitter.Row + 1}/{blitter.Height}" : "idle")</span>
                    <span class="sub">@($"{blitter.Width}×{blitter.Height} at {blitter.X},{blitter.Y}")</span>
                    break;
                case Rasterizer rasterizer:
                    <span class="mem" title="@($"{rasterizer.JobsDone} lists done, {rasterizer.TrianglesDrawn} triangles, {rasterizer.PixelsDrawn} pixels drawn, {rasterizer.PixelsHidden} hidden")">@(rasterizer.Busy ? $"{rasterizer.Stage} {rasterizer.Triangle + 1}/{rasterizer.Count}" : "idle")</span>
                    <span class="sub">@($"{rasterizer.PixelsDrawn} drawn · {rasterizer.PixelsHidden} hidden")</span>
                    break;
                case DepthBuffer depthBuffer:
                    <span class="mem">cursor <strong>@depthBuffer.X, @depthBuffer.Y</strong></span>
                    <span class="sub">depth there @depthBuffer.DepthAt(depthBuffer.X, depthBuffer.Y)</span>
                    break;
                case MultiplyAccumulate mac:
                    <span class="mem" title="@($"a {mac.A}, b {mac.B}, accumulator {mac.Accumulator}")">acc <strong>@mac.Accumulator</strong></span>
                    <span class="sub">@($"out {mac.Result} · a {mac.A} · b {mac.B}")</span>
                    break;
                case Keypad keypad:
                    <span class="dev-keys">
                        @foreach (var (key, label) in new[] { (Keypad.Keys.Up, "↑"), (Keypad.Keys.Down, "↓"), (Keypad.Keys.Left, "←"), (Keypad.Keys.Right, "→"), (Keypad.Keys.Space, "␣") })
                        {
                            <i class="@((keypad.Data & (int)key) != 0 ? "on" : "")">@label</i>
                        }
                    </span>
                    <span class="sub">@($"0x{keypad.Data:X2}")</span>
                    break;
                case ALU:
                    var op = Signals.FirstOrDefault();
                    <span class="mem">@(op ?? "idle")</span>
                    @if (op != null && AluResult != null) { <span class="sub">= @Hex(AluResult.Value)</span> }
                    break;
            }
        </div>
        @if (Built is DualPortRegister || Built is InstructionRegister || (Built is Register && Built is not StatusRegister))
        {
            var word = Built switch { DualPortRegister dualWord => dualWord.Data, InstructionRegister stepWord => stepWord.Data, _ => ((Register)Built).Data };
            <div class="dev-bits" title="@($"bits 15..0 = {Convert.ToString(word & 0xFFFF, 2).PadLeft(16, '0')}")">
                @for (int bit = 15; bit >= 0; bit--)
                {
                    <i class="@(((word >> bit) & 1) != 0 ? "on" : "")"></i>
                }
            </div>
        }
        @if (Signals.Count > 0 && Sockets.Count == 0)
        {
            <div class="dev-signals">@foreach (var line in Signals) { <span>@line</span> }</div>
        }
    }
    @for (int i = 0; i < Sockets.Count; i++)
    {
        var socket = Sockets[i];
        <div class="socket-row" style="top:@Px(SchematicLayout.SocketRowY(i) - SchematicLayout.SocketRowHeight / 2)" title="@socket.Description">
            <span class="socket-name">@socket.Label</span>
            <span class="socket-target @(socket.Target == null ? "missing" : "")">@(socket.Target ?? (OnSocketPointerDown.HasDelegate ? socket.Missing : "none"))</span>
            @if (OnSocketPointerDown.HasDelegate)
            {
                <span class="socket" @onpointerdown="e => OnSocketPointerDown.InvokeAsync((e, socket.Name))" @onpointerdown:stopPropagation></span>
            }
        </div>
    }
    @if (Device != null && Layout != null)
    {
        var ports = Layout.Info(Device).Ports;
        foreach (var port in ports)
        {
            var anchor = Layout.PortAnchor(Device, port);
            var busId = Device.GetPortBus(port);
            <span class="port @(busId == null ? "unconnected" : "") @(OnPortPointerDown.HasDelegate ? "grab" : "")"
                  style="left:@Px(anchor.X - Left - 7); top:@Px(anchor.Y - Top - 7); background:@(busId == null ? "var(--surface)" : BusColor?.Invoke(busId))"
                  title="Port '@port': @(busId == null ? "drag to a bus" : $"on bus {busId}")"
                  @onpointerdown="e => OnPortPointerDown.InvokeAsync((e, port))" @onpointerdown:stopPropagation="OnPortPointerDown.HasDelegate"></span>
            @if (ports.Count > 1)
            {
                <span class="port-label" style="left:@Px(anchor.X - Left + 8); top:@Px(anchor.Bottom ? Height + 1 : -15)">@port</span>
            }
        }
    }
</div>
