<div class="source">
    <div class="source-head">
        <span class="silk">@Label</span>
        <span class="grow"></span>
        <label class="btn btn-sm btn-outline-secondary mb-0">
            Load file…<InputFile OnChange="LoadFile" class="d-none" />
        </label>
    </div>
    <textarea class="source-text" rows="@Rows" spellcheck="false" @bind="Value" @bind:after="() => ValueChanged.InvokeAsync(Value)"></textarea>
</div>

@code
{
    private const long MaxFileSize = 1024 * 1024;

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public int Rows { get; set; } = 12;

    [Parameter]
    public string Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        using var reader = new System.IO.StreamReader(e.File.OpenReadStream(MaxFileSize));
        Value = await reader.ReadToEndAsync();
        await ValueChanged.InvokeAsync(Value);
    }
}
