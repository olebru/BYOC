@if (Errors?.Count > 0)
{
    <div class="errors">
        <div class="errors-head silk">@Errors.Count problem@(Errors.Count == 1 ? "" : "s")</div>
        @foreach (var error in Errors)
        {
            <div class="error">@error</div>
        }
    </div>
}

@code
{
    [Parameter]
    public IReadOnlyList<string> Errors { get; set; }
}
