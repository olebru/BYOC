@page "/"

<div class="workspace-header">
    <ul class="nav nav-tabs">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == tab ? "active" : "")" href="" @onclick="() => ActiveTab = tab" @onclick:preventDefault>
                    @tab
                    @if (tab == "Design" && DefinitionErrors.Count > 0) { <span class="badge badge-danger ml-1">@DefinitionErrors.Count</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount > 0) { <span class="badge badge-danger ml-1">@MicrocodeErrorCount</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount == 0 && MicrocodeWarningCount > 0) { <span class="badge badge-warning ml-1">@MicrocodeWarningCount</span> }
                    @if (tab == "Program" && ProgramErrors.Count > 0) { <span class="badge badge-danger ml-1">@ProgramErrors.Count</span> }
                    @if (tab == "JSON" && ParseErrors.Count > 0) { <span class="badge badge-danger ml-1">@ParseErrors.Count</span> }
                </a>
            </li>
        }
    </ul>
    <div class="workspace-actions">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetToDefault">Reset to default</button>
    </div>
</div>

@if (ActiveTab == "Design")
{
    <MachineEditor Definition="Definition" DefinitionChanged="OnDesignChanged" Errors="DefinitionErrors" Preview="C" Registry="Registry" />
}
else if (ActiveTab == "Microcode")
{
    <MicrocodeEditor Microcode="Microcode" MicrocodeChanged="OnMicrocodeChanged" Machine="Definition" Diagnostics="MicrocodeDiagnostics" Registry="Registry" />
}
else if (ActiveTab == "Program")
{
    <SourceEditorComponent Label="Program (assembly)" Value="@Program" ValueChanged="OnProgramChanged" Rows="30" />
    <ErrorList Errors="ProgramErrors" />
}
else if (ActiveTab == "JSON")
{
    <ErrorList Errors="ParseErrors" />
    <div class="row">
        <div class="col-lg-6">
            <SourceEditorComponent Label="Machine definition (JSON), kept in sync with the designer" Value="@DefinitionJson" ValueChanged="OnJsonChanged" Rows="30" />
        </div>
        <div class="col-lg-6">
            <SourceEditorComponent Label="Microcode (JSON, or a legacy tab separated ROM), kept in sync with the microcode editor" Value="@MicrocodeJson" ValueChanged="OnMicrocodeJsonChanged" Rows="30" />
        </div>
    </div>
}
else if (ActiveTab == "Run")
{
    <ErrorList Errors="AllErrors.ToList()" />
    @if (C != null)
    {
        <h3>@(C.Definition.Name ?? "Unnamed machine")</h3>
        <div class="mb-2">
            <button class="btn btn-primary" @onclick="Step" disabled="@C.IsHalted">Step</button>
            <button class="btn btn-primary" @onclick="() => StepMany(10)" disabled="@C.IsHalted">Step 10</button>
            <button class="btn btn-primary" @onclick="() => StepMany(MaxRunCycles)" disabled="@C.IsHalted">Run to halt</button>
            <button class="btn btn-outline-secondary" @onclick="Rebuild">Restart</button>
            <span class="ml-3">Cycle @C.Cycles @(C.IsHalted ? "(halted)" : "")</span>
        </div>

        <div class="mb-2">
            @foreach (var bus in C.Buses.Values)
            {
                <div><strong>Bus @bus.ID</strong>: @string.Join(", ", bus.devices.Select(d => d.ID()))</div>
            }
        </div>

        <div>
            @foreach (var mi in C.CurrentMicroCode)
            {
                <div><code>@mi.ToSingleLineString()</code></div>
            }
        </div>

        <RegisterListComponent Registers="@(C.Devices.OfType<Register>())"></RegisterListComponent>
        @foreach (var dualPort in C.Devices.OfType<DualPortRegister>())
        {
            <div class="card m-3" style="min-width: 18rem; max-width:30.5%;">
                <div class="card-header"><h3>@dualPort.DisplayName()</h3></div>
                <div class="card-footer text-center">@dualPort.Data</div>
            </div>
        }
        @if (ProgramMemory != null)
        {
            <RAMComponent RamModule=@ProgramMemory></RAMComponent>
        }
        @foreach (var mmu in C.Devices.OfType<MMU>())
        {
            <MMUComponent MMU=@mmu></MMUComponent>
        }
    }
}
