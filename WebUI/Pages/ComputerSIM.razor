@page "/"

<div class="workspace-header">
    <ul class="nav nav-tabs">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == tab ? "active" : "")" href="" @onclick="() => ActiveTab = tab" @onclick:preventDefault>
                    @tab
                    @if (tab == "Design" && DefinitionErrors.Count > 0) { <span class="badge badge-danger ml-1">@DefinitionErrors.Count</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount > 0) { <span class="badge badge-danger ml-1">@MicrocodeErrorCount</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount == 0 && MicrocodeWarningCount > 0) { <span class="badge badge-warning ml-1">@MicrocodeWarningCount</span> }
                    @if (tab == "Program" && ProgramErrors.Count > 0) { <span class="badge badge-danger ml-1">@ProgramErrors.Count</span> }
                    @if (tab == "JSON" && ParseErrors.Count > 0) { <span class="badge badge-danger ml-1">@ParseErrors.Count</span> }
                </a>
            </li>
        }
    </ul>
    <div class="workspace-actions">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetToDefault">Reset to default</button>
    </div>
</div>

@if (ActiveTab == "Design")
{
    <MachineEditor Definition="Definition" DefinitionChanged="OnDesignChanged" Errors="DefinitionErrors" Preview="C" Registry="Registry"
                   History="History" OnOpenMicrocode="OpenMicrocode" FocusDevice="@focusDevice" FocusVersion="focusVersion" />
}
else if (ActiveTab == "Microcode")
{
    @if (Definition.Decoder?.Microcode == null)
    {
        <div class="alert alert-warning">
            This machine has no microcode yet.
            <button class="btn btn-sm btn-primary ml-2" @onclick="StartMicrocode">Start with an empty fetch routine</button>
        </div>
    }
    else
    {
        <MicrocodeEditor Microcode="Definition.Decoder.Microcode" MicrocodeChanged="OnMicrocodeChanged" Machine="Definition" Diagnostics="MicrocodeDiagnostics" Registry="Registry"
                         History="History" OnOpenDevice="OpenDevice" FocusMnemonic="@focusMnemonic" FocusStep="focusStep" FocusVersion="focusVersion" />
    }
}
else if (ActiveTab == "Program")
{
    <div class="examples">
        <span class="examples-label">Example programs for the default machine</span>
        @foreach (var example in ExampleData.Programs)
        {
            <button class="btn btn-sm @(Program == example.Source ? "btn-primary" : "btn-outline-primary")" @onclick="() => LoadExample(example.Source)">@example.Name</button>
        }
    </div>
    <SourceEditorComponent Label="Program (assembly): label TAB mnemonic TAB operands" Value="@Program" ValueChanged="OnProgramChanged" Rows="30" />
    <ErrorList Errors="ProgramErrors" />
}
else if (ActiveTab == "JSON")
{
    <ErrorList Errors="ParseErrors" />
    <SourceEditorComponent Label="Machine definition (JSON) with its microcode in decoder.microcode, kept in sync with both editors" Value="@DefinitionJson" ValueChanged="OnJsonChanged" Rows="34" />
}
else if (ActiveTab == "Run")
{
    @if (C == null)
    {
        <div class="alert alert-warning">The machine can not run until these problems are fixed:</div>
        <ErrorList Errors="AllErrors.ToList()" />
    }
    else
    {
        <RunView Machine="C" Registry="Registry" OnRestart="Rebuild" />
    }
}
