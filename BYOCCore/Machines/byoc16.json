{
  "name": "BYOC-16",
  "buses": [
    { "id": "main" }
  ],
  "devices": [
    { "id": "regi", "type": "instructionRegister", "name": "REGINSTR", "bus": "main" },
    { "id": "pc", "type": "programCounter", "name": "PCOUNT", "bus": "main" },
    { "id": "regsp", "type": "register", "name": "REGSP", "bus": "main", "parameters": { "initialValue": 4095 } },
    { "id": "rega", "type": "register", "name": "REGA", "bus": "main" },
    { "id": "regb", "type": "register", "name": "REGB", "bus": "main" },
    { "id": "regc", "type": "register", "name": "REGC", "bus": "main" },
    { "id": "regs", "type": "register", "name": "REGSWAP", "bus": "main" },
    {
      "id": "alu", "type": "alu", "name": "ALU", "bus": "main",
      "connections": { "a": "rega", "b": "regb", "status": "regsta" }
    },
    { "id": "regsta", "type": "statusRegister", "name": "STATUS", "bus": "main" },
    { "id": "mem", "type": "ram", "name": "BASEMEM", "bus": "main", "parameters": { "size": 4096 } },
    { "id": "mmu", "type": "mmu", "name": "MMU", "bus": "main", "parameters": { "banks": 16, "bankSize": 4096 } },
    { "id": "clk", "type": "clock", "name": "Clock" },
    { "id": "lcd", "type": "display", "name": "LCD", "bus": "main", "parameters": { "columns": 32, "rows": 4 } }
  ],
  "decoder": { "status": "regsta", "instruction": "regi" },
  "halt": "clk",
  "programMemory": "mem"
}
