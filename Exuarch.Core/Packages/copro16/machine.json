{
  "name": "COPRO-16",
  "buses": [
    {
      "id": "main",
      "layout": { "x": 0, "y": 190 }
    },
    {
      "id": "video",
      "layout": { "x": 0, "y": 470 }
    }
  ],
  "devices": [
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "main",
      "layout": { "x": 30, "y": 50 }
    },
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "bus": "main",
      "layout": { "x": 216, "y": 50 }
    },
    {
      "id": "mem",
      "type": "ram",
      "name": "MEMORY",
      "bus": "main",
      "parameters": { "size": 4096 },
      "layout": { "x": 402, "y": 50 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "main",
      "layout": { "x": 588, "y": 50 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "CLOCK",
      "layout": { "x": 960, "y": 50 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 774, "y": 50 }
    },
    {
      "id": "a",
      "type": "register",
      "name": "A",
      "bus": "main",
      "layout": { "x": 30, "y": 250 }
    },
    {
      "id": "b",
      "type": "register",
      "name": "B",
      "bus": "main",
      "layout": { "x": 216, "y": 250 }
    },
    {
      "id": "t",
      "type": "register",
      "name": "ALU OPERAND",
      "bus": "main",
      "layout": { "x": 402, "y": 250 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "a", "b": "t", "status": "flags" },
      "layout": { "x": 588, "y": 230 }
    },
    {
      "id": "blit",
      "type": "blitter",
      "name": "BLITTER",
      "buses": { "host": "main", "video": "video" },
      "connections": { "screen": "fb" },
      "layout": { "x": 960, "y": 300 }
    },
    {
      "id": "fb",
      "type": "framebuffer",
      "name": "SCREEN",
      "bus": "video",
      "layout": { "x": 960, "y": 510 }
    }
  ],
  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "microcode": {
      "name": "COPRO-16 microcode",
      "fetch": {
        "mnemonic": "FETCH",
        "description": "Load the opcode at the address in PC into IR and step PC past it; no interrupt check",
        "steps": [
          {
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "signals": ["mem.output", "ir.load", "pc.inc"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Do nothing; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock, halting the machine; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LDI",
          "description": "A = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "a.load"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "B = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LBA",
          "description": "B = the address after the opcode, for walking a table with LDX; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "A = the cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Store A in the cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LDX",
          "description": "A = the cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TAB",
          "description": "B = A; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "b.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "A = B; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A + 1, wrapping from 0xFFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B + 1, wrapping from 0xFFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A + B, with B copied through ALU OPERAND; sets Z, N, C (carry out) and V (signed overflow)",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B, with B copied through ALU OPERAND; sets Z, N, C (borrow: A < B unsigned) and V (signed overflow)",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "AND",
          "description": "A = A AND B, with B copied through ALU OPERAND; sets Z and N, clears C and V",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "EOR",
          "description": "A = A XOR B, with B copied through ALU OPERAND; sets Z and N, clears C and V",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.eor", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Set the flags for A - B without changing A: Z if equal, C if A < B unsigned, N and V as for SUB",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "A = A + the value after the opcode; sets Z, N, C (carry out) and V (signed overflow)",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "A = A - the value after the opcode; sets Z, N, C (borrow: A < value unsigned) and V (signed overflow)",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ANDI",
          "description": "A = A AND the value after the opcode; sets Z and N, clears C and V",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "EORI",
          "description": "A = A XOR the value after the opcode; sets Z and N, clears C and V",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.eor", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Set the flags for A - the value after the opcode without changing A: Z if equal, C if A < value unsigned, N and V as for SUB",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "Jump to the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jump to the address after the opcode if Z is set (equal after CMP); otherwise go on with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jump to the address after the opcode if Z is clear (not equal after CMP); otherwise go on with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCS",
          "description": "Jump to the address after the opcode if C is set (carry out after ADD, A < B unsigned after CMP); otherwise go on with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCC",
          "description": "Jump to the address after the opcode if C is clear (no carry after ADD, A >= B unsigned after CMP); otherwise go on with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "OUT",
          "description": "Print the low 8 bits of A as a Latin-1 character at the LCD cursor and move the cursor on (0x0A new line, 0x0D start of row, scrolls when full); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "lcd.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CLT",
          "description": "Blank the LCD and move its cursor to the top left; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["lcd.clear", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BX",
          "description": "Set the blitter's left column to A, taking effect at once even mid-fill; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "blit.loadx", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BXI",
          "description": "Set the blitter's left column to the value after the opcode, taking effect at once even mid-fill; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "blit.loadx"]
            }
          ]
        },
        {
          "mnemonic": "BY",
          "description": "Set the blitter's top row to A, taking effect at once even mid-fill; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "blit.loady", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BYI",
          "description": "Set the blitter's top row to the value after the opcode, taking effect at once even mid-fill; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "blit.loady"]
            }
          ]
        },
        {
          "mnemonic": "BW",
          "description": "Set the blitter's rectangle width to A, taking effect at once even mid-fill; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "blit.loadw", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BWI",
          "description": "Set the blitter's rectangle width to the value after the opcode, taking effect at once even mid-fill; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "blit.loadw"]
            }
          ]
        },
        {
          "mnemonic": "BH",
          "description": "Set the blitter's rectangle height to A, taking effect at once even mid-fill; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "blit.loadh", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BHI",
          "description": "Set the blitter's rectangle height to the value after the opcode, taking effect at once even mid-fill; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "blit.loadh"]
            }
          ]
        },
        {
          "mnemonic": "BC",
          "description": "Set the blitter's fill colour (RGB565) to A, taking effect at once even mid-fill; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "blit.loadcolour", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BCI",
          "description": "Set the blitter's fill colour (RGB565) to the value after the opcode, taking effect at once even mid-fill; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "blit.loadcolour"]
            }
          ]
        },
        {
          "mnemonic": "GO",
          "description": "Start the blitter filling its rectangle on the screen, one pixel per tick while the CPU runs on; ignored if it is busy or width or height is 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["blit.start", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BST",
          "description": "A = the blitter's status: 1 while it is filling, 0 when idle; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["blit.status", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CLS",
          "description": "Clear every screen pixel to 0 (black) and move the framebuffer's cursor to 0, 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["fb.clear", "ir.reset"]
            }
          ]
        }
      ]
    }
  },
  "halt": "clk",
  "programMemory": "mem"
}
