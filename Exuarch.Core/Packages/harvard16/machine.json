{
  "name": "HARVARD-16",
  "buses": [
    {
      "id": "ibus",
      "layout": { "x": 0, "y": 222 }
    },
    {
      "id": "dbus",
      "layout": { "x": 0, "y": 626 }
    },
    {
      "id": "iobus",
      "layout": { "x": 0, "y": 1000 }
    }
  ],
  "devices": [
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "ibus",
      "layout": { "x": 30, "y": 40 }
    },
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "bus": "ibus",
      "layout": { "x": 240, "y": 40 }
    },
    {
      "id": "pmem",
      "type": "ram",
      "name": "PROGRAM MEMORY",
      "bus": "ibus",
      "parameters": { "size": 4096 },
      "layout": { "x": 30, "y": 278 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "CLOCK",
      "layout": { "x": 450, "y": 40 }
    },
    {
      "id": "opr",
      "type": "dualPortRegister",
      "name": "IBUS \u21C4 DBUS",
      "buses": { "a": "ibus", "b": "dbus" },
      "layout": { "x": 240, "y": 278 }
    },
    {
      "id": "a",
      "type": "register",
      "name": "A",
      "bus": "dbus",
      "layout": { "x": 30, "y": 444 }
    },
    {
      "id": "b",
      "type": "register",
      "name": "B",
      "bus": "dbus",
      "layout": { "x": 660, "y": 444 }
    },
    {
      "id": "t",
      "type": "register",
      "name": "ALU OPERAND",
      "bus": "dbus",
      "layout": { "x": 30, "y": 682 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "dbus",
      "connections": { "a": "a", "b": "t", "status": "flags" },
      "layout": { "x": 450, "y": 444 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "dbus",
      "layout": { "x": 240, "y": 682 }
    },
    {
      "id": "io",
      "type": "dualPortRegister",
      "name": "DBUS \u21C4 IOBUS",
      "buses": { "a": "dbus", "b": "iobus" },
      "layout": { "x": 450, "y": 682 }
    },
    {
      "id": "dmem",
      "type": "ram",
      "name": "DATA MEMORY",
      "bus": "dbus",
      "parameters": { "size": 4096 },
      "layout": { "x": 870, "y": 444 }
    },
    {
      "id": "sp",
      "type": "register",
      "name": "SP",
      "bus": "dbus",
      "layout": { "x": 660, "y": 682 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "iobus",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 30, "y": 848 }
    },
    {
      "id": "fb",
      "type": "framebuffer",
      "name": "SCREEN",
      "bus": "iobus",
      "layout": { "x": 30, "y": 1056 }
    },
    {
      "id": "keys",
      "type": "keypad",
      "name": "KEYPAD",
      "bus": "iobus",
      "layout": { "x": 240, "y": 848 }
    }
  ],
  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "microcode": {
      "name": "HARVARD-16 microcode",
      "fetch": {
        "mnemonic": "FETCH",
        "description": "Load the opcode at PC in program memory into IR and step PC past it; most instructions do this fetch for their successor in their own last steps, so the routine itself only runs at start-up and after jumps, calls and returns",
        "steps": [
          {
            "signals": ["pc.output", "pmem.loadmar"]
          },
          {
            "signals": ["pmem.output", "ir.load", "pc.inc"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Do nothing except fetch the next instruction; registers, memory and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock, halting the machine with PC at the cell after HLT; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LDI",
          "description": "A = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "a.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "B = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "b.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LBA",
          "description": "B = the label address after the opcode (same steps as LBI), to walk a table in program memory with LPM; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "b.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "A = the data memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["dmem.output", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDB",
          "description": "B = the data memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["dmem.output", "b.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Store A in the data memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["a.output", "dmem.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STB",
          "description": "Store B in the data memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["b.output", "dmem.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDX",
          "description": "A = the data memory cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["dmem.output", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STX",
          "description": "Store A in the data memory cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "dmem.loadmar", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["a.output", "dmem.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LPM",
          "description": "A = the program memory cell at the address in B, for tables and strings stored with the program; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "opr.loadb"]
            },
            {
              "signals": ["opr.outputa", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada"]
            },
            {
              "signals": ["opr.outputb", "a.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "TAB",
          "description": "B = A; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "b.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "A = B; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "a.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.inc", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DEA",
          "description": "A = A - 1, wrapping from 0 to FFFF; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.dec", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.inc", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DEB",
          "description": "B = B - 1, wrapping from 0 to FFFF; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.dec", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A \u002B B; sets Z, N, C (carry out) and V (signed overflow); ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.add", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B; sets Z, N, V (signed overflow) and C if A \u003C B unsigned (borrow); ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.sub", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "AND",
          "description": "A = A AND B, bitwise; sets Z and N, clears C and V; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.and", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ORR",
          "description": "A = A OR B, bitwise; sets Z and N, clears C and V; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.orr", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "EOR",
          "description": "A = A XOR B, bitwise; sets Z and N, clears C and V; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.eor", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LSL",
          "description": "A = A shifted left by the low 4 bits of B (0 to 15), zeros in; sets Z and N, C to the last bit shifted out (clear for a shift of 0), clears V; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.lsl", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LSR",
          "description": "A = A shifted right by the low 4 bits of B (0 to 15), zeros in; sets Z and N, C to the last bit shifted out (clear for a shift of 0), clears V; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.lsr", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Set the flags for A - B without changing A: Z if equal, C if A \u003C B unsigned, N from bit 15 of the difference, V on signed overflow; ALU OPERAND is left holding B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.cmp", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "A = A \u002B the value after the opcode; sets Z, N, C (carry out) and V (signed overflow); ALU OPERAND is left holding the value",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.add", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "A = A - the value after the opcode; sets Z, N, V (signed overflow) and C if A \u003C value unsigned (borrow); ALU OPERAND is left holding the value",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.sub", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ANDI",
          "description": "A = A AND the value after the opcode, bitwise; sets Z and N, clears C and V; ALU OPERAND is left holding the value",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.and", "a.load", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Set the flags for A - the value after the opcode without changing A: Z if equal, C if A \u003C value unsigned, N from bit 15, V on signed overflow; ALU OPERAND is left holding the value",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "t.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.cmp", "pmem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "Jump to the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jump to the address after the opcode if Z is set (equal after CMP); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jump to the address after the opcode if Z is clear (not equal after CMP); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": false },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCS",
          "description": "Jump to the address after the opcode if C is set (A \u003C B unsigned after CMP, or a carry out of ADD); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": true },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCC",
          "description": "Jump to the address after the opcode if C is clear (A \u003E= B unsigned after CMP, or no carry out of ADD); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": false },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "C": false },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JMI",
          "description": "Jump to the address after the opcode if N is set (bit 15 of the last ALU result set); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": true },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "N": true },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JPL",
          "description": "Jump to the address after the opcode if N is clear (bit 15 of the last ALU result clear); otherwise go on with the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": false },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "N": false },
              "signals": ["pmem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CALL",
