{
  "name": "RF-16",
  "buses": [
    {
      "id": "main",
      "layout": { "x": 0, "y": 190 }
    }
  ],
  "devices": [
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "bus": "main",
      "layout": { "x": 30, "y": 50 }
    },
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "main",
      "layout": { "x": 216, "y": 50 }
    },
    {
      "id": "rf",
      "type": "registerFile",
      "name": "R0-R7",
      "bus": "main",
      "parameters": { "count": 8 },
      "layout": { "x": 402, "y": 50 }
    },
    {
      "id": "d",
      "type": "register",
      "name": "DESTINATION",
      "bus": "main",
      "layout": { "x": 588, "y": 50 }
    },
    {
      "id": "sp",
      "type": "register",
      "name": "SP",
      "bus": "main",
      "layout": { "x": 774, "y": 50 }
    },
    {
      "id": "mem",
      "type": "ram",
      "name": "MEMORY",
      "bus": "main",
      "parameters": { "size": 4096 },
      "layout": { "x": 960, "y": 50 }
    },
    {
      "id": "x",
      "type": "register",
      "name": "ALU A",
      "bus": "main",
      "layout": { "x": 30, "y": 250 }
    },
    {
      "id": "y",
      "type": "register",
      "name": "ALU B",
      "bus": "main",
      "layout": { "x": 216, "y": 250 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "x", "b": "y", "status": "flags" },
      "layout": { "x": 402, "y": 250 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "main",
      "layout": { "x": 588, "y": 250 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 774, "y": 250 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "CLOCK",
      "layout": { "x": 960, "y": 250 }
    }
  ],
  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "microcode": {
      "name": "RF-16 microcode",
      "fetch": {
        "mnemonic": "FETCH",
        "description": "Read the opcode at the address in PC into the micro step counter and add 1 to PC, so PC points at the first operand",
        "steps": [
          {
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "signals": ["mem.output", "ir.load", "pc.inc"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Do nothing and go on to the next instruction; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock, halting the machine with PC pointing past the HLT; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "MOVI",
          "description": "Rd = value, the 16-bit word after the register operand; flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADR",
          "description": "Rd = address, the address of a label, to use as a pointer with LDR and STR; flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "MOV",
          "description": "Rd = Rs, copying the register and leaving Rs unchanged; flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["x.output", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "Rd = Rd \u002B Rs; sets Z, N, C (carry out) and V (signed overflow)",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.add", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "Rd = Rd - Rs; sets Z, N, C (Rd \u003C Rs unsigned, a borrow) and V (signed overflow)",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.sub", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "AND",
          "description": "Rd = Rd AND Rs, bitwise; sets Z and N from the result, clears C and V",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.and", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ORR",
          "description": "Rd = Rd OR Rs, bitwise; sets Z and N from the result, clears C and V",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.orr", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "EOR",
          "description": "Rd = Rd XOR Rs, bitwise; sets Z and N from the result, clears C and V",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.eor", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Set the flags for Rd - Rs without changing Rd: Z if equal, C if Rd \u003C Rs unsigned, N from bit 15, V on signed overflow",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "Rd = Rd \u002B value; sets Z, N, C (carry out) and V (signed overflow)",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "y.load"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.add", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "Rd = Rd - value; sets Z, N, C (Rd \u003C value unsigned, a borrow) and V (signed overflow)",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "y.load"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.sub", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ANDI",
          "description": "Rd = Rd AND value, bitwise; sets Z and N from the result, clears C and V",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "y.load"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.and", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Set the flags for Rd - value without changing Rd: Z if equal, C if Rd \u003C value unsigned, N from bit 15, V on signed overflow",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "y.load"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LDR",
          "description": "Rd = the memory cell at the address in Ra (modulo the 4096-cell memory); flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "mem.loadmar"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["mem.output", "rf.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STR",
          "description": "Store Rs in the memory cell at the address in Ra (modulo the 4096-cell memory); flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "d.load"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "mem.loadmar"]
            },
            {
              "signals": ["d.output", "rf.select"]
            },
            {
              "signals": ["rf.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INC",
          "description": "Rd = Rd \u002B 1, wrapping from FFFF to 0 at 16 bits; flags unchanged",
          "operands": 1,
          "operandTypes": ["register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "DEC",
          "description": "Rd = Rd - 1, wrapping from 0 to FFFF at 16 bits; flags unchanged",
          "operands": 1,
          "operandTypes": ["register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.dec", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "PUSH",
          "description": "SP = SP - 1, then store Rs at the address in SP; the stack grows down and SP points at the last value pushed; flags unchanged",
          "operands": 1,
          "operandTypes": ["register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select", "sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["rf.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "POP",
          "description": "Rd = the memory cell at the address in SP, then SP = SP \u002B 1; flags unchanged",
          "operands": 1,
          "operandTypes": ["register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rf.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "OUT",
          "description": "Print the low 8 bits of Rs as a Latin-1 character at the LCD cursor and move the cursor right (line feed and carriage return move it to a row start); flags unchanged",
          "operands": 1,
          "operandTypes": ["register"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "rf.select"]
            },
            {
              "signals": ["rf.output", "lcd.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CLT",
          "description": "Clear the LCD to spaces and move the cursor to the top-left cell; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["lcd.clear", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "B",
          "description": "PC = address, an unconditional jump to the address; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BEQ",
          "description": "PC = address if Z is set (equal after a CMP), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BNE",
          "description": "PC = address if Z is clear (not equal after a CMP), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BCS",
          "description": "PC = address if C is set (Rd \u003C Rs unsigned after a CMP, or a carry out after ADD), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BCC",
          "description": "PC = address if C is clear (Rd \u003E= Rs unsigned after a CMP), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BMI",
          "description": "PC = address if N is set (bit 15 of the last ALU result set, negative), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "N": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "BPL",
          "description": "PC = address if N is clear (bit 15 of the last ALU result clear, zero or positive), otherwise go to the next instruction; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "N": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CALL",
          "description": "SP = SP - 1, store the address after the CALL at the address in SP, then PC = address; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "d.load", "sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["pc.output", "mem.load"]
            },
            {
              "signals": ["d.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "RET",
          "description": "PC = the memory cell at the address in SP, then SP = SP \u002B 1, returning from a CALL; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "sp.inc", "ir.reset"]
            }
          ]
        }
      ]
    },
    "layout": { "x": 1146, "y": 50 }
  },
  "halt": "clk",
  "programMemory": "mem"
}
