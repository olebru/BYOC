{
  "name": "BYOC-16",
  "buses": [
    { "id": "main" }
  ],
  "devices": [
    { "id": "regi", "type": "instructionRegister", "name": "REGINSTR", "bus": "main" },
    { "id": "pc", "type": "register", "name": "PCOUNT", "bus": "main" },
    {
      "id": "regsp",
      "type": "register",
      "name": "REGSP",
      "bus": "main"
    },
    { "id": "rega", "type": "register", "name": "REGA", "bus": "main" },
    { "id": "regb", "type": "register", "name": "REGB", "bus": "main" },
    { "id": "regc", "type": "register", "name": "REGC", "bus": "main" },
    { "id": "regs", "type": "register", "name": "REGSWAP", "bus": "main" },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "rega", "b": "regb", "status": "regsta" }
    },
    { "id": "regsta", "type": "statusRegister", "name": "STATUS", "bus": "main" },
    {
      "id": "mem",
      "type": "ram",
      "name": "BASEMEM",
      "bus": "main",
      "parameters": { "size": 4096 }
    },
    {
      "id": "mmu",
      "type": "mmu",
      "name": "MMU",
      "bus": "main",
      "parameters": { "banks": 16, "bankSize": 4096 }
    },
    { "id": "clk", "type": "clock", "name": "Clock" },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 }
    },
    { "id": "fb", "type": "framebuffer", "name": "SCREEN", "bus": "main" },
    { "id": "keys", "type": "keypad", "name": "KEYPAD", "bus": "main" }
  ],
  "decoder": {
    "status": "regsta",
    "instructionRegister": "regi",
    "microcode": {
      "name": "BYOC-16 microcode",
      "fetch": {
        "mnemonic": "FTC",
        "description": "Fetch: load the opcode at the program counter into the micro step register",
        "steps": [
          {
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "signals": ["mem.output", "regi.load"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "TAB",
          "description": "Copy A to B",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "regb.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "Copy B to A",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A \u002B B, sets Z C V",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.add", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B, sets Z N C V",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.sub", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Store A in the selected memory bank at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["rega.output", "mmu.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STB",
          "description": "Store B in the selected memory bank at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["regb.output", "mmu.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LRA",
          "description": "Load A from base memory at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["rega.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LRB",
          "description": "Load B from base memory at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["regb.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "Load A from the selected memory bank at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["rega.load", "mmu.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDB",
          "description": "Load B from the selected memory bank at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["regb.load", "mmu.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PSA",
          "description": "Push A on the stack in bank 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.dec"]
            },
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack", "mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["rega.output", "mmu.load"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs"]
            },
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "POA",
          "description": "Pop A from the stack in bank 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["rega.load", "mmu.output", "regsp.inc"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PSB",
          "description": "Push B on the stack in bank 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.dec"]
            },
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack", "mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["regb.output", "mmu.load"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs"]
            },
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "POB",
          "description": "Pop B from the stack in bank 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["regb.load", "mmu.output", "regsp.inc"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "NOP",
          "description": "Do nothing",
          "operands": 0,
          "steps": [
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LNA",
          "description": "Load A from base memory at the operand address \u002B B",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load"]
            },
            {
              "signals": ["alu.add", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Compare A with B, sets Z N C V",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.cmp", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "Jump to the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["pc.load", "mem.output", "regi.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jump to the operand address if Z is set",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jump to the operand address if Z is clear",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "RST",
          "description": "Clear the status flags",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsta.reset", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JC",
          "description": "Jump to the operand address if C is set",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LPA",
          "description": "Load A from base memory at the address stored at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "regs.load"]
            },
            {
              "signals": ["regs.output", "mem.loadmar"]
            },
            {
              "signals": ["rega.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LPB",
          "description": "Load B from base memory at the address stored at the operand address",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "regs.load"]
            },
            {
              "signals": ["regs.output", "mem.loadmar"]
            },
            {
              "signals": ["regb.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Halt the machine",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LAI",
          "description": "Load A with the operand",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "Load B with the operand",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "regb.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PEA",
          "description": "Peek: load A from the top of the stack without popping",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.output", "mmu.loadmar"]
            },
            {
              "signals": ["mmu.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PEB",
          "description": "Peek: load B from the top of the stack without popping",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.output", "mmu.loadmar"]
            },
            {
              "signals": ["mmu.output", "regb.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SWB",
          "description": "Select the memory bank given by the operand",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A \u002B 1, flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.inc", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B \u002B 1, flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.inc", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DCL",
          "description": "Clear the display",
          "operands": 0,
          "steps": [
            {
              "signals": ["lcd.clear", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWA",
          "description": "Print A on the display",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWB",
          "description": "Print B on the display",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWI",
          "description": "Print the operand character on the display",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GCL",
          "description": "Clear the screen and move its cursor to 0, 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["fb.clear", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GXI",
          "description": "Move the screen cursor to column x (0-639)",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.loadx", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GYI",
          "description": "Move the screen cursor to row y (0-479)",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.loady", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GXA",
          "description": "Move the screen cursor to the column in A",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "fb.loadx", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GYA",
          "description": "Move the screen cursor to the row in A",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "fb.loady", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GPI",
          "description": "Plot the RGB565 colour at the cursor and move right",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.plot", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GPA",
          "description": "Plot the RGB565 colour in A at the cursor and move right",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "fb.plot", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GPB",
          "description": "Plot the RGB565 colour in B at the cursor and move right",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.output", "fb.plot", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LKA",
          "description": "Load A with the keys: 1 up, 2 down, 4 left, 8 right, 16 space",
          "operands": 0,
          "steps": [
            {
              "signals": ["keys.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        }
      ]
    }
  },
  "halt": "clk",
  "programMemory": "mem"
}
